# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800

# Discord OAuth / bot (create values in Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEV_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:4000/api/v1/auth/discord/callback

# Database / cache
DATABASE_URL=postgresql://vreeo:vreeo_dev_only@localhost:5432/vreeo?schema=public
REDIS_URL=redis://localhost:6379
