# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

# Local infrastructure (docker-compose.yml)
DATABASE_URL=postgresql://vreeo:vreeo_dev_only@localhost:5432/vreeo?schema=public
REDIS_URL=redis://localhost:6379

# Discord application credentials — required to run the bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# API
API_HOST=0.0.0.0
API_PORT=3001
