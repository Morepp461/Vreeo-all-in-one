# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

# Local infrastructure (docker-compose.yml)
DATABASE_URL=postgresql://vreeo:vreeo_dev_only@localhost:5432/vreeo?schema=public
REDIS_URL=redis://localhost:6379

# Discord bot credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# Discord OAuth2 dashboard login. Configure all three together in the Developer Portal.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# API and dashboard
API_HOST=0.0.0.0
API_PORT=3001
APP_BASE_URL=http://localhost:3000
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=vreeo_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
