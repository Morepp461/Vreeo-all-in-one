{
  "name": "@vreeo/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "commands:deploy": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "zod": "^4.1.12",
    "dotenv": "^16.6.1",
    "@vreeo/database": "workspace:*"
  }
}
