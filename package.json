{
  "name": "vreeo",
  "version": "0.1.0",
  "private": true,
  "description": "VREEO all-in-one Discord management platform",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vreeo/database build && pnpm --parallel --filter @vreeo/api --filter @vreeo/bot --filter @vreeo/dashboard dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @vreeo/database build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @vreeo/database db:generate",
    "db:validate": "pnpm --filter @vreeo/database db:validate",
    "db:migrate:dev": "pnpm --filter @vreeo/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @vreeo/database db:migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
