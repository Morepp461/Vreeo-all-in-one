{
  "name": "vreeo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "prettier --check package.json pnpm-workspace.yaml turbo.json tsconfig.base.json .prettierrc.json",
    "format": "prettier --write .",
    "clean": "turbo run clean"
