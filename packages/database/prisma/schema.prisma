generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  discordUserId  String         @unique @map("discord_user_id") @db.VarChar(32)
  username       String         @db.VarChar(100)
  displayName    String         @map("display_name") @db.VarChar(100)
  avatarUrl      String         @map("avatar_url") @db.Text
  locale         String         @db.VarChar(10)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  oauthAccounts  OAuthAccount[]
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([lastLoginAt])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(50)
  providerAccountId String   @map("provider_account_id") @db.VarChar(128)
  scopes            Json     @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionHash String  @map("session_hash") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Guild {
  id                 String              @id @default(uuid()) @db.Uuid
  discordGuildId     String              @unique @map("discord_guild_id") @db.VarChar(32)
  name               String              @db.VarChar(200)
  iconUrl            String              @map("icon_url") @db.Text
  ownerDiscordUserId String              @map("owner_discord_user_id") @db.VarChar(32)
  active             Boolean
  botJoinedAt        DateTime?           @map("bot_joined_at") @db.Timestamptz(6)
  lastSeenAt         DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings           GuildSetting?
  features           GuildFeature[]
  members            GuildMember[]
  memberRoles        GuildMemberRole[]
  roles              GuildRole[]
  channels           GuildChannel[]
  permissionRoles    PermissionRole[]
  permissionOverrides PermissionOverride[]
  moderationCases    ModerationCase[]
  warnings           Warning[]
  appeals            Appeal[]
  auditLogs          AuditLog[]

  @@index([active])
  @@index([ownerDiscordUserId])
  @@map("guilds")
}

model GuildSetting {
  id                    String   @id @default(uuid()) @db.Uuid
  guildId               String   @unique @map("guild_id") @db.Uuid
  locale                String   @db.VarChar(10)
  timezone              String   @db.VarChar(64)
  prefix                String?  @db.VarChar(20)
  defaultLogChannelId   String?  @map("default_log_channel_id") @db.VarChar(32)
  defaultStaffRoleId    String?  @map("default_staff_role_id") @db.VarChar(32)
  config                Json     @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild                 Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("guild_settings")
}

model GuildFeature {
  id        String   @id @default(uuid()) @db.Uuid
  guildId   String   @map("guild_id") @db.Uuid
  featureKey String  @map("feature_key") @db.VarChar(100)
  enabled   Boolean
  config    Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, featureKey])
  @@index([guildId, enabled])
  @@map("guild_features")
}

model GuildMember {
  id            String           @id @default(uuid()) @db.Uuid
  guildId       String           @map("guild_id") @db.Uuid
  userId        String?          @map("user_id") @db.Uuid
  discordUserId String           @map("discord_user_id") @db.VarChar(32)
  nickname      String?          @db.VarChar(100)
  joinedAt      DateTime         @map("joined_at") @db.Timestamptz(6)
  leftAt        DateTime?        @map("left_at") @db.Timestamptz(6)
  isMember      Boolean          @map("is_member")
  isVerified    Boolean          @map("is_verified")
  metadata      Json             @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild         Guild            @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  roles         GuildMemberRole[]

  @@unique([guildId, discordUserId])
  @@index([guildId, isMember])
  @@index([userId])
  @@map("guild_members")
}

model GuildMemberRole {
  id             String      @id @default(uuid()) @db.Uuid
  guildId        String      @map("guild_id") @db.Uuid
  memberId       String      @map("member_id") @db.Uuid
  discordRoleId  String      @map("discord_role_id") @db.VarChar(32)
  assignedAt     DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt      DateTime?   @map("removed_at") @db.Timestamptz(6)
  guild          Guild       @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  member         GuildMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([memberId, discordRoleId])
  @@index([guildId, removedAt])
  @@map("guild_member_roles")
}

model GuildRole {
  id            String   @id @default(uuid()) @db.Uuid
  guildId       String   @map("guild_id") @db.Uuid
  discordRoleId String   @map("discord_role_id") @db.VarChar(32)
  name          String   @db.VarChar(100)
  position      Int
  managed       Boolean
  permissions   String   @db.Text
  color         Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, discordRoleId])
  @@index([guildId, position])
  @@map("guild_roles")
}

model GuildChannel {
  id                      String   @id @default(uuid()) @db.Uuid
  guildId                 String   @map("guild_id") @db.Uuid
  discordChannelId        String   @map("discord_channel_id") @db.VarChar(32)
  parentDiscordChannelId  String?  @map("parent_discord_channel_id") @db.VarChar(32)
  name                    String   @db.VarChar(100)
  type                    String   @db.VarChar(50)
  position                Int
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild                   Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, discordChannelId])
  @@index([guildId, type])
  @@map("guild_channels")
}

model PermissionRole {
  id           String   @id @default(uuid()) @db.Uuid
  guildId      String   @map("guild_id") @db.Uuid
  discordRoleId String  @map("discord_role_id") @db.VarChar(32)
  permissionSet Json    @map("permission_set") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, discordRoleId])
  @@map("permission_roles")
}

model PermissionOverride {
  id                String   @id @default(uuid()) @db.Uuid
  guildId           String   @map("guild_id") @db.Uuid
  subjectType       String   @map("subject_type") @db.VarChar(30)
  subjectDiscordId  String   @map("subject_discord_id") @db.VarChar(32)
  permissionKey     String   @map("permission_key") @db.VarChar(150)
  effect            String   @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([guildId, permissionKey])
  @@map("permission_overrides")
}

model ModerationCase {
  id                    String           @id @default(uuid()) @db.Uuid
  guildId               String           @map("guild_id") @db.Uuid
  caseNumber            BigInt           @map("case_number")
  targetDiscordUserId   String           @map("target_discord_user_id") @db.VarChar(32)
  moderatorDiscordUserId String          @map("moderator_discord_user_id") @db.VarChar(32)
  action                String           @db.VarChar(50)
  reason                String           @db.Text
  evidence              Json             @db.JsonB
  durationSeconds       BigInt?          @map("duration_seconds")
  status                String           @db.VarChar(30)
  relatedCaseId         String?          @map("related_case_id") @db.Uuid
  expiresAt             DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild                 Guild            @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedCase           ModerationCase?  @relation("RelatedCases", fields: [relatedCaseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  relatedCases          ModerationCase[] @relation("RelatedCases")
  warnings              Warning[]
  appeals               Appeal[]

  @@unique([guildId, caseNumber])
  @@index([targetDiscordUserId])
  @@index([moderatorDiscordUserId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("moderation_cases")
}

model Warning {
  id                  String          @id @default(uuid()) @db.Uuid
  guildId             String          @map("guild_id") @db.Uuid
  targetDiscordUserId String          @map("target_discord_user_id") @db.VarChar(32)
  moderatorDiscordUserId String       @map("moderator_discord_user_id") @db.VarChar(32)
  reason              String          @db.Text
  caseId              String?         @map("case_id") @db.Uuid
  expiresAt           DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild               Guild           @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  case                ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([guildId, targetDiscordUserId, createdAt])
  @@index([expiresAt])
  @@map("warnings")
}

model Appeal {
  id                    String         @id @default(uuid()) @db.Uuid
  guildId               String         @map("guild_id") @db.Uuid
  caseId                String         @map("case_id") @db.Uuid
  appellantDiscordUserId String        @map("appellant_discord_user_id") @db.VarChar(32)
  status                String         @db.VarChar(30)
  reason                String         @db.Text
  evidence              Json           @db.JsonB
  decision              String?        @db.Text
  reviewerDiscordUserId String?        @map("reviewer_discord_user_id") @db.VarChar(32)
  submittedAt           DateTime       @map("submitted_at") @db.Timestamptz(6)
  reviewedAt            DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guild                 Guild          @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  case                  ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([guildId, status, submittedAt])
  @@index([caseId])
  @@map("appeals")
}

model Plan {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique @db.VarChar(50)
  name        String       @db.VarChar(100)
  description String       @db.Text
  active      Boolean
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  features    PlanFeature[]

  @@map("plans")
}

model PlanFeature {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar(150)
  enabled    Boolean
  limitValue BigInt?  @map("limit_value")
  limitUnit  String?  @map("limit_unit") @db.VarChar(50)
  config     Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model FeatureFlag {
  id        String               @id @default(uuid()) @db.Uuid
  key       String               @unique @db.VarChar(150)
  state     String               @db.VarChar(20)
  config    Json                 @db.JsonB
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id            String     @id @default(uuid()) @db.Uuid
  featureFlagId String     @map("feature_flag_id") @db.Uuid
  scopeType     String     @map("scope_type") @db.VarChar(30)
  scopeId       String     @map("scope_id") @db.VarChar(100)
  state         String     @db.VarChar(20)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([featureFlagId, scopeType, scopeId])
  @@map("feature_flag_overrides")
}

model AuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  guildId              String?  @map("guild_id") @db.Uuid
  actorUserId          String?  @map("actor_user_id") @db.Uuid
  actorDiscordUserId   String?  @map("actor_discord_user_id") @db.VarChar(32)
  action               String   @db.VarChar(150)
  resourceType         String   @map("resource_type") @db.VarChar(100)
  resourceId           String?  @map("resource_id") @db.VarChar(100)
  oldValue             Json?    @map("old_value") @db.JsonB
  newValue             Json?    @map("new_value") @db.JsonB
  source               String   @db.VarChar(50)
  correlationId        String?  @map("correlation_id") @db.VarChar(100)
  ipHash               String?  @map("ip_hash") @db.VarChar(128)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  guild                Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorUser            User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([guildId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(100)
  keyHash        String   @map("key_hash") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, keyHash])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
